# Committed defaults for the Nebius inference box. Override per machine in .secrets.env / .instance.env.
NEBIUS_INSTANCE_NAME="overversion-infer"
NEBIUS_PLATFORM="gpu-h100-sxm"
NEBIUS_PRESET="1gpu-16vcpu-200gb"
NEBIUS_IMAGE_FAMILY="ubuntu24.04-cuda13.0"   # driver 580.x, CUDA 13.0, Docker + NVIDIA Container Toolkit included
# A provisioned box uses about 65 GiB: ~40 for the SGLang image, ~16 for Qwen3-8B.
# 100 leaves room for a second model without paying for idle space. The disk is
# the only thing that bills while the VM is stopped, and Nebius disks grow but
# never shrink, so raising this later is easy and lowering it means a rebuild.
NEBIUS_BOOT_DISK_GIB="100"
# NETWORK_SSD is 3x mirrored at $0.118/GiB/month. Everything on this disk is
# reproducible from a registry, Hugging Face and this repo, so
# NETWORK_SSD_NON_REPLICATED ($0.053) is a defensible halving if you want it.
NEBIUS_BOOT_DISK_TYPE="network_ssd"
SSH_USER="user"                               # created by cloud-init below
SSH_KEY_PUB="${HOME}/.ssh/id_ed25519.pub"

# Inference stack
SGLANG_IMAGE="lmsysorg/sglang:v0.5.19-cu129"  # pinned; the envelope records the digest
MODEL_ID="Qwen/Qwen3-8B"
SERVED_MODEL_NAME="qwen3-8b"
ATTENTION_BACKEND="fa3"                      # what deterministic mode picks on SM90; pinned explicitly
INFER_DOMAIN="infer.overversion.com"
RUN_BASELINE="1"                             # also run a non-deterministic instance at /baseline/ for the comparison panel
DATA_DIR="/data"

# Remote OpenTofu state (see state-bucket.sh). Bucket names are global across Nebius.
TFSTATE_BUCKET="overversion-tfstate"
TFSTATE_REGION="eu-north1"
